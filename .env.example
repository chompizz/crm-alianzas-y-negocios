DATABASE_URL="postgresql://usuario:clave@host:5432/nexo"
# Generar con: npx auth secret
AUTH_SECRET=""
# Usuario administrador inicial (lo crea `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@ejemplo.com"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"
# Necesario fuera de Vercel (Railway, servidor propio)
AUTH_TRUST_HOST="true"
# Avisos por email a los responsables (opcional; sin estas variables no se envían)
RESEND_API_KEY=""
EMAIL_FROM=""  # p. ej. Nexo <avisos@tudominio.com>
# Dirección pública de Nexo, para los enlaces de los emails
APP_URL=""  # p. ej. https://nexo.tudominio.com
